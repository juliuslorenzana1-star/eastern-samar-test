{
  "name": "eastern-samar-community-action-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "staging": "node scripts/staging/start.mjs",
    "test:staging": "node scripts/staging/e2e.mjs",
    "demo:presentation": "node scripts/presentation/demo.mjs",
    "test:presentation": "node scripts/presentation/rehearse.mjs",
    "video:record": "node scripts/presentation/rehearse.mjs --record",
    "i18n:check": "node scripts/build-locales.mjs --check && node scripts/check-locales.mjs",
    "test:i18n:browser": "node tests/i18n-browser.mjs",
    "typecheck:functions": "npm exec --yes --package=deno@2.9.6 -- deno check supabase/functions/analyze-report/index.ts supabase/functions/send-email-notification/index.ts",
    "test:browser": "node tests/run-browser.mjs",
    "test:public:live": "node tests/public-live-browser.mjs",
    "test": "node --test tests/*.test.mjs supabase/functions/send-email-notification/index.test.mjs",
    "test:database": "node --test tests/database.integration.mjs",
    "test:moderation:browser": "node tests/moderation-browser.mjs",
    "test:readiness": "node tests/run-readiness.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "test:onboarding": "node --test tests/onboarding.test.mjs",
    "test:onboarding:browser": "node tests/onboarding-browser.mjs",
    "test:interface:browser": "node tests/interface-browser.mjs",
    "test:redesign:browser": "node tests/redesign-browser.mjs",
    "test:anonymous": "node --test tests/visitor-security.test.mjs tests/visitor.integration.mjs",
    "test:anonymous:browser": "node tests/visitor-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "i18next": "26.5.12",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.9",
    "react-leaflet": "5.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
