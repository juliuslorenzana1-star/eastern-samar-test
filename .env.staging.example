# Copy to ignored .env.staging.local only after a dedicated backend is approved.
# Never use an existing application ref or production key here.
VITE_APP_ENVIRONMENT=staging
VITE_STAGING_PROJECT_REF=REPLACE_WITH_DEDICATED_STAGING_REF
VITE_SUPABASE_URL=https://REPLACE_WITH_DEDICATED_STAGING_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
VITE_ENABLE_PERSONAL_DATA_COLLECTION=true
VITE_ENABLE_AI_SCREENING=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
# Test-runner credentials are never VITE_ values and must never be committed.
STAGING_RESIDENT_EMAIL=
STAGING_RESIDENT_PASSWORD=
STAGING_OBSERVER_EMAIL=
STAGING_OBSERVER_PASSWORD=
STAGING_MODERATOR_EMAIL=
STAGING_MODERATOR_PASSWORD=
STAGING_OUTSIDER_EMAIL=
STAGING_OUTSIDER_PASSWORD=
